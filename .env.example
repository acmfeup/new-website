# Copy to .env at the repo root to override any of these.

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://acmfeup:acmfeup@localhost:5432/acmfeup

# Port the NestJS API listens on.
API_PORT=4000

# Comma separated list of origins the API accepts requests from.
CORS_ORIGIN=http://localhost:3000

# Where the web app looks for the API. Inlined into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Better Auth: public URL of the API. Google redirects back to
# <this>/api/auth/callback/google, so the OAuth client must list that URI.
BETTER_AUTH_URL=http://localhost:4000

# Signs session cookies. Optional locally (Better Auth uses a dev secret);
# required in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client (Web application). Empty disables Google login locally.
# Redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
