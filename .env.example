# Copy to .env at the repo root to override any of these.

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://plataforma:plataforma@localhost:5432/plataforma

# Port the NestJS API listens on.
API_PORT=4000

# Comma separated list of origins the API accepts requests from.
CORS_ORIGIN=http://localhost:3000

# Where the web app looks for the API. Inlined into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000
